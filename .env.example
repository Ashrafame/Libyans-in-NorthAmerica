# ---------------------------------------------------------------------------
# Libyans in North America
# ---------------------------------------------------------------------------
# Without Supabase and Stripe keys the app runs in demo mode: data is stored in
# .data/db.json, email codes are shown on screen, and donations are recorded
# locally. Fill these values to switch to the real services.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used to sign member/admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

# Supabase (server side uses the secret key; never expose it to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback for older Supabase projects
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
